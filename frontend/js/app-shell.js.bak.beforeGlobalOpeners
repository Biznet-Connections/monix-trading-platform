// ================================================================
// MONIX v7.0 — App shell (topbar + sidebar + bottom nav + tabs)
// Runs alongside the existing app.js, does NOT replace it.
// ================================================================

const MONIX_TABS = [
  { id: 'home',     icon: 'fa-house',         label: 'Home' },
  { id: 'invest',   icon: 'fa-chart-line',    label: 'Invest' },
  { id: 'wallet',   icon: 'fa-wallet',        label: 'Wallet' },
  { id: 'activity', icon: 'fa-clock-rotate-left', label: 'Activity' },
  { id: 'me',       icon: 'fa-user',          label: 'Me' },
];

let MONIX_STATE = {
  activeTab: 'home',
  user: null,
  balance: 0,
  todayProfit: 0,
  winRate: 0,
  voucher: null,
};

function monixShellInit() {
  console.log('[Shell] Initializing app shell v7.0');
  wireShellNav();
  switchShellTab('home');
}

function renderSidebar() {
  const el = document.getElementById('appSidebar');
  if (!el) return;

  const tabs = MONIX_TABS.map(t => `
    <div class="app-nav-item${t.id === MONIX_STATE.activeTab ? ' active' : ''}" data-shell-tab="${t.id}">
      <i class="fa-solid ${t.icon}"></i><span>${t.label}</span>
    </div>
  `).join('');

  const u = MONIX_STATE.user || {};
  const initial = (u.username || u.email || 'U').trim().charAt(0).toUpperCase();

  el.innerHTML = `
    <div class="app-sidebar-brand">
      <div class="app-sidebar-brand-mark">M</div>
      <div class="app-sidebar-brand-text">
        <div class="app-sidebar-brand-title">MONIX <span style="color:var(--accent-hi)">AI</span></div>
        <div class="app-sidebar-brand-sub">v7.0 Investment</div>
      </div>
    </div>
    <div class="app-nav-section">Main</div>
    ${tabs}
    <div class="app-sidebar-spacer"></div>
    <div class="app-nav-section">Account</div>
    <div class="app-nav-item" data-shell-action="api-keys"><i class="fa-solid fa-key"></i><span>API Keys</span></div>
    <div class="app-nav-item" data-shell-action="settings"><i class="fa-solid fa-gear"></i><span>Settings</span></div>
    <div class="app-nav-item" data-shell-action="admin"><i class="fa-solid fa-shield-halved"></i><span>Admin</span></div>
    <div class="app-user-card" data-shell-action="logout">
      <div class="app-user-avatar">${initial}</div>
      <div class="app-user-info">
        <div class="app-user-name">${u.username || 'Guest'}</div>
        <div class="app-user-meta">${u.email || ''}</div>
      </div>
      <i class="fa-solid fa-right-from-bracket" style="color:var(--muted);font-size:12px;"></i>
    </div>
  `;
}

function renderBottomNav() {
  const el = document.getElementById('appBottomNav');
  if (!el) return;
  el.innerHTML = MONIX_TABS.map(t => `
    <button class="app-bottom-tab${t.id === MONIX_STATE.activeTab ? ' active' : ''}" data-shell-tab="${t.id}">
      <i class="fa-solid ${t.icon}"></i><span>${t.label}</span>
    </button>
  `).join('');
}

function renderTopbar() {
  // v7.0 — topbar mode pill hidden; status is shown in Home hero instead
  const modeEl = document.getElementById('appTopbarMode');
  if (modeEl) modeEl.style.display = 'none';
}

function switchShellTab(tabId) {
  MONIX_STATE.activeTab = tabId;

  document.querySelectorAll('.app-tab').forEach(t => {
    t.classList.toggle('active', t.getAttribute('data-shell-tab') === tabId);
  });
  renderSidebar();
  renderBottomNav();

  // Call per-tab render function if it exists
  const fn = window['renderShellTab_' + tabId];
  if (typeof fn === 'function') {
    try { fn(); } catch (e) { console.warn('[Shell] Tab render error for', tabId, e); }
  }
}

function wireShellNav() {
  document.addEventListener('click', (e) => {
    const tabEl = e.target.closest('[data-shell-tab]');
    if (tabEl) {
      e.preventDefault();
      e.stopPropagation();
      switchShellTab(tabEl.getAttribute('data-shell-tab'));
      return;
    }

    const actionEl = e.target.closest('[data-shell-action]');
    if (actionEl) {
      e.preventDefault();
      e.stopPropagation();
      handleShellAction(actionEl.getAttribute('data-shell-action'));
    }
  });
}

function handleShellAction(action) {
  switch (action) {
    case 'api-keys':
      document.getElementById('openApiKeys')?.click();
      break;
    case 'settings':
      document.getElementById('openSettings')?.click();
      break;
    case 'admin':
      document.getElementById('adminLink')?.click();
      break;
    case 'logout':
      document.getElementById('logoutBtn')?.click();
      break;
  }
}

// Called from existing app.js after user data loads
window.monixUpdateUser = function(profile) {
  if (!profile) return;
  MONIX_STATE.user = profile.user || null;
  MONIX_STATE.balance = (profile.derivBalance && profile.derivBalance.balance) || 0;
  MONIX_STATE.todayProfit = profile.stats?.today_profit || 0;
  MONIX_STATE.winRate = profile.stats?.win_rate || 0;
  MONIX_STATE.voucher = {
    code: profile.user?.voucher_code || 'MONIX-XXXX',
    remaining: profile.user?.trades_remaining || 0,
    limit: 1000000,
  };

  renderSidebar();
  renderTopbar();

  if (MONIX_STATE.activeTab === 'home' && typeof window.renderShellTab_home === 'function') {
    window.renderShellTab_home();
  }
};

window.monixSwitchTab = switchShellTab;
window.monixShellInit = monixShellInit;

// Auto-init when DOM ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', monixShellInit);
} else {
  setTimeout(monixShellInit, 100);
}

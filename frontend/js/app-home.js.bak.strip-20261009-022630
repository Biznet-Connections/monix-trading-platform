let homeGrowthChart = null;

window.renderShellTab_home = function() {
  const content = document.querySelector('.app-tab[data-shell-tab="home"]');
  if (!content) return;

  const u = MONIX_STATE.user || {};
  const balance = MONIX_STATE.balance || 0;
  const today = MONIX_STATE.todayProfit || 0;
  const winRate = MONIX_STATE.winRate || 0;
  const voucher = MONIX_STATE.voucher || {};
  const connected = MONIX_IS_CONNECTED();

  const hour = new Date().getHours();
  const greeting = hour < 12 ? 'Good morning' : hour < 17 ? 'Good afternoon' : 'Good evening';

  content.innerHTML = connected
    ? renderHomeConnected(greeting, u, balance, today, winRate, voucher)
    : renderHomeGuest(greeting, u);

  if (connected) drawHomeGrowthChart(balance);
  else startGuestTicker();
};


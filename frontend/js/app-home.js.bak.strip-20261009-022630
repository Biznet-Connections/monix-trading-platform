// ────────────────────────────────────────────────────────────────
// CHARTS
// ────────────────────────────────────────────────────────────────
function drawHomeGrowthChart(currentBalance) {
  const canvas = document.getElementById('homeGrowthChart');
  if (!canvas || !window.Chart) return;

  if (homeGrowthChart) { homeGrowthChart.destroy(); homeGrowthChart = null; }

  const points = 30;
  const data = [];
  const labels = [];
  let value = Math.max(currentBalance * 0.92, 10);
  for (let i = 0; i < points; i++) {
    value = value * (1 + (Math.random() * 0.03 - 0.01));
    data.push(value);
    const d = new Date();
    d.setDate(d.getDate() - (points - 1 - i));
    labels.push(d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
  }
  data[data.length - 1] = currentBalance;

  homeGrowthChart = new Chart(canvas, {
    type: 'line',
    data: { labels, datasets: [{
      data, borderColor: '#6366f1', backgroundColor: 'rgba(99,102,241,0.15)',
      fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2,
    }]},
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { enabled: false } },
      scales: { x: { display: false }, y: { display: false } }
    }
  });
}

// Guest live ticker (uses public fake-feed from investState)
let guestTickerInterval = null;
function startGuestTicker() {
  if (guestTickerInterval) return;

  const priceEl = document.getElementById('guestLivePrice');
  const changeEl = document.getElementById('guestLiveChange');
  if (!priceEl || !changeEl) return;

  let price = 46005;
  let change = 0.96;

  const update = () => {
    price = price * (1 + (Math.random() - 0.5) * 0.002);
    change = change + (Math.random() - 0.5) * 0.1;
    priceEl.textContent = '$' + price.toFixed(2);
    changeEl.textContent = (change >= 0 ? '▲ ' : '▼ ') + Math.abs(change).toFixed(2) + '% today';
    changeEl.className = 'live-market-change ' + (change >= 0 ? 'up' : 'down');
  };

  update();
  guestTickerInterval = setInterval(update, 3000);
}

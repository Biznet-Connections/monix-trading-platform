/* Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    transition: all 0.3s ease;
    min-height: 100vh;
}

body.dark-theme {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    color: #f8fafc;
}

body.light-theme {
    background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 100%);
    color: #0f172a;
}

/* ================================================================ */
/* ð LOADING SCREEN - GLOWING "M"                                  */
/* ================================================================ */
#loadingScreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #0a0a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99999;
    transition: opacity 0.8s ease, visibility 0.8s ease;
}

#loadingScreen.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.loading-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    position: relative;
}

/* ---------- GLOWING "M" ---------- */
.m-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 200px;
}

.glowing-m {
    font-size: 160px;
    font-weight: 900;
    font-family: 'Arial Black', 'Impact', sans-serif;
    letter-spacing: -10px;
    line-height: 1;
    position: relative;
    z-index: 2;
    background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 40%, #818cf8 70%, #6366f1 100%);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 4s ease-in-out infinite, floatPulse 3s ease-in-out infinite;
    filter: drop-shadow(0 0 40px rgba(99, 102, 241, 0.8))
            drop-shadow(0 0 80px rgba(99, 102, 241, 0.4))
            drop-shadow(0 0 120px rgba(99, 102, 241, 0.2));
}

@keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

@keyframes floatPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
}

/* ---------- GLOW RINGS ---------- */
.glow-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 2px solid rgba(99, 102, 241, 0.15);
    animation: ringPulse 3s ease-in-out infinite;
    z-index: 1;
}

.glow-ring-2 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 1px solid rgba(99, 102, 241, 0.08);
    animation: ringPulse 3s ease-in-out infinite 0.5s;
    z-index: 0;
}

@keyframes ringPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
    50% { transform: translate(-50%, -50%) scale(1.15); opacity: 0.2; }
}

/* ---------- PARTICLES ---------- */
.particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
}

.particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: radial-gradient(circle, #818cf8, transparent);
    border-radius: 50%;
    animation: particleFloat 4s ease-in-out infinite;
}

.particle:nth-child(1) { top: 10%; left: 20%; animation-delay: 0s; width: 6px; height: 6px; }
.particle:nth-child(2) { top: 15%; right: 15%; animation-delay: 0.4s; }
.particle:nth-child(3) { bottom: 20%; left: 10%; animation-delay: 0.8s; width: 8px; height: 8px; }
.particle:nth-child(4) { bottom: 15%; right: 20%; animation-delay: 1.2s; }
.particle:nth-child(5) { top: 45%; left: 5%; animation-delay: 0.2s; width: 5px; height: 5px; }
.particle:nth-child(6) { top: 40%; right: 5%; animation-delay: 0.6s; }
.particle:nth-child(7) { top: 5%; left: 50%; animation-delay: 1s; width: 7px; height: 7px; }
.particle:nth-child(8) { bottom: 5%; left: 50%; animation-delay: 1.4s; }
.particle:nth-child(9) { top: 30%; left: 30%; animation-delay: 0.3s; width: 4px; height: 4px; }
.particle:nth-child(10) { top: 30%; right: 30%; animation-delay: 0.7s; }
.particle:nth-child(11) { bottom: 30%; left: 30%; animation-delay: 1.1s; width: 6px; height: 6px; }
.particle:nth-child(12) { bottom: 30%; right: 30%; animation-delay: 1.5s; }

@keyframes particleFloat {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.2; }
    25% { transform: translate(-15px, -20px) scale(1.5); opacity: 0.8; }
    50% { transform: translate(10px, -30px) scale(1); opacity: 0.4; }
    75% { transform: translate(-10px, -10px) scale(1.3); opacity: 0.7; }
}

/* ---------- TYPING TEXT ---------- */
.loading-text-wrapper {
    display: flex;
    align-items: center;
    gap: 2px;
    min-height: 40px;
}

.loading-text {
    font-size: 18px;
    font-weight: 300;
    letter-spacing: 6px;
    color: #c4b5fd;
    font-family: 'Courier New', monospace;
    text-transform: uppercase;
    background: linear-gradient(135deg, #c4b5fd, #818cf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    min-width: 10px;
}

.cursor-blink {
    font-size: 24px;
    font-weight: 300;
    color: #818cf8;
    animation: blink 0.8s step-end infinite;
    -webkit-text-fill-color: #818cf8;
}

@keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
}

/* ---------- VERSION ---------- */
.loading-version {
    font-size: 11px;
    letter-spacing: 3px;
    color: rgba(99, 102, 241, 0.3);
    font-family: 'Courier New', monospace;
    margin-top: 5px;
    animation: versionPulse 2s ease-in-out infinite;
}

@keyframes versionPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.7; }
}

/* ---------- LOADING SCREEN RESPONSIVE ---------- */
@media (max-width: 640px) {
    .glowing-m { font-size: 100px; letter-spacing: -6px; }
    .m-wrapper { width: 140px; height: 140px; }
    .glow-ring { width: 160px; height: 160px; }
    .glow-ring-2 { width: 200px; height: 200px; }
    .loading-text { font-size: 14px; letter-spacing: 4px; }
    .loading-version { font-size: 9px; }
}

@media (max-width: 400px) {
    .glowing-m { font-size: 72px; letter-spacing: -4px; }
    .m-wrapper { width: 100px; height: 100px; }
    .glow-ring { width: 120px; height: 120px; }
    .glow-ring-2 { width: 150px; height: 150px; }
    .loading-text { font-size: 11px; letter-spacing: 3px; }
}

/* ================================================================ */
/* GLASS CARD EFFECT                                               */
/* ================================================================ */
.glass-card {
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(99, 102, 241, 0.15);
    transition: all 0.3s ease;
}

body.light-theme .glass-card {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
}

.sidebar-glass {
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(12px);
    border-right: 1px solid rgba(99, 102, 241, 0.1);
}

body.light-theme .sidebar-glass {
    background: rgba(255, 255, 255, 0.95);
    border-right: 1px solid rgba(0, 0, 0, 0.1);
}

/* ================================================================ */
/* MODAL STYLES                                                    */
/* ================================================================ */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(4px);
}

.modal-content {
    border-radius: 1rem;
    max-height: 90vh;
    overflow-y: auto;
}

.hidden {
    display: none !important;
}

/* ================================================================ */
/* SIDEBAR DRAWER                                                  */
/* ================================================================ */
.sidebar-drawer {
    transform: translateX(-100%);
    transition: transform 0.3s ease-in-out;
    z-index: 100;
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 280px;
}

.sidebar-drawer.open {
    transform: translateX(0);
}

.mobile-menu-btn {
    display: flex !important;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 50;
}

.mobile-menu-btn:hover {
    background: rgba(99, 102, 241, 0.3);
    transform: scale(1.05);
}

@media (min-width: 1024px) {
    .sidebar-drawer { transform: translateX(-100%); position: fixed; }
    .sidebar-drawer.open { transform: translateX(0); }
    .mobile-menu-btn { display: flex !important; }
    .main-content { margin-left: 0 !important; }
}

@media (max-width: 1023px) {
    .main-content { margin-left: 0 !important; }
    .mobile-menu-btn { display: flex !important; }
}

.drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 90;
    display: none;
}

.drawer-overlay.open { display: block; }

#closeDrawerBtn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
}

#closeDrawerBtn:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
}

/* ================================================================ */
/* TABS                                                             */
/* ================================================================ */
.tab-btn {
    transition: all 0.2s ease;
    cursor: pointer;
}

.tab-btn.active {
    color: #4f46e5;
    border-bottom: 2px solid #4f46e5;
}

.tab-pane { display: block; }
.tab-pane.hidden { display: none; }

.admin-tab {
    cursor: pointer;
    transition: all 0.2s ease;
}

.admin-tab.active {
    color: #4f46e5;
    border-bottom: 2px solid #4f46e5;
}

.admin-tab-pane { display: block; }
.admin-tab-pane.hidden { display: none; }

/* ================================================================ */
/* SCROLLBAR                                                        */
/* ================================================================ */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: #1e293b; border-radius: 10px; }
::-webkit-scrollbar-thumb { background: #4f46e5; border-radius: 10px; }
body.light-theme ::-webkit-scrollbar-track { background: #cbd5e1; }
body.light-theme ::-webkit-scrollbar-thumb { background: #6366f1; }

/* ================================================================ */
/* HOVER EFFECTS                                                    */
/* ================================================================ */
.hover-card:hover {
    transform: translateY(-2px);
    transition: all 0.2s ease;
    border-color: rgba(99, 102, 241, 0.4);
}

button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ================================================================ */
/* ANIMATIONS                                                       */
/* ================================================================ */
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

/* ================================================================ */
/* TOAST NOTIFICATIONS                                              */
/* ================================================================ */
.toast {
    background: rgba(15, 23, 42, 0.95);
    backdrop-filter: blur(8px);
    border-radius: 0.75rem;
    padding: 0.75rem 1.5rem;
    min-width: 250px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
    animation: slideIn 0.3s ease-out;
}

.toast-success { border-left: 4px solid #22c55e; }
.toast-error { border-left: 4px solid #ef4444; }
.toast-info { border-left: 4px solid #4f46e5; }

@keyframes slideIn {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

/* ================================================================ */
/* LOADING SPINNER                                                  */
/* ================================================================ */
.spinner {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-top-color: #4f46e5;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    display: inline-block;
}

@keyframes spin { to { transform: rotate(360deg); } }

/* ================================================================ */
/* RESPONSIVE TABLES                                                */
/* ================================================================ */
@media (max-width: 768px) {
    .overflow-x-auto {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    table { min-width: 600px; }
    .p-4 { padding: 0.75rem; }
}

a, button, .nav-link, #openApiKeys, #openSettings, #adminLink, .tf-btn, .tab-btn, .admin-tab {
    cursor: pointer;
}

.drawer-overlay { pointer-events: auto; }
.sidebar-drawer nav a { pointer-events: auto; z-index: 101; }

@keyframes modalFadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
}

@keyframes signalPulse { 0%,100%{opacity:1} 50%{opacity:0.6} }

@media (max-width: 640px) {
    #aiReasonModal .modal-content { width: 95%; margin: 0 auto; }
}


/* ================================================================ */
/* DESKTOP SIDEBAR COLLAPSE                                          */
/* ================================================================ */
@media (min-width: 1024px) {
    body.sidebar-collapsed #sidebarDrawer {
        transform: translateX(-100%) !important;
    }
    body.sidebar-collapsed .main-content {
        margin-left: 0 !important;
    }
    body.sidebar-collapsed #desktopHamburger {
        position: fixed;
        left: 1rem;
        top: 1rem;
        z-index: 60;
    }
}

/* ================================================================
   MONIX v7.0 â App shell redesign (obliXel style)
   Design tokens Â· 1px borders Â· one accent Â· 3 type sizes
   ================================================================ */

:root {
  --bg:         #0a0a0f;
  --panel:      #131320;
  --elevated:   #1c1c2e;
  --hover:      #252540;
  --border:     #26263a;
  --border-hi:  #35354d;
  --text:       #f5f5f7;
  --meta:       #a1a1aa;
  --muted:      #71717a;
  --accent:     #6366f1;
  --accent-hi:  #818cf8;
  --success:    #10b981;
  --danger:     #ef4444;
  --warning:    #f59e0b;
}

body.dark-theme {
  background: var(--bg) !important;
  color: var(--text);
}

/* ---------- Shell ---------- */
.app-shell {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: 100vh;
  background: var(--bg);
}

.app-sidebar {
  background: var(--panel);
  border-right: 1px solid var(--border);
  padding: 20px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
}

.app-sidebar-brand {
  padding: 8px 12px 20px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.app-sidebar-brand-mark {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent), #4f46e5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 900;
  color: #fff;
  flex-shrink: 0;
}

.app-sidebar-brand-text { display: flex; flex-direction: column; }
.app-sidebar-brand-title { font-size: 14px; font-weight: 700; letter-spacing: -0.2px; }
.app-sidebar-brand-sub { font-size: 10px; color: var(--muted); letter-spacing: 0.4px; }

.app-nav-section {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--muted);
  padding: 16px 12px 6px;
}

.app-nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 12px;
  border-radius: 8px;
  color: var(--meta);
  font-size: 13.5px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.12s;
  border-left: 2px solid transparent;
  text-decoration: none;
  user-select: none;
}

.app-nav-item:hover { background: var(--elevated); color: var(--text); }
.app-nav-item.active {
  background: var(--elevated);
  color: var(--text);
  border-left-color: var(--accent);
}
.app-nav-item i { width: 18px; text-align: center; font-size: 14px; opacity: 0.9; }
.app-nav-item.active i { color: var(--accent-hi); }

.app-sidebar-spacer { flex: 1; }

.app-user-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--elevated);
  border-radius: 10px;
  margin-top: 12px;
  cursor: pointer;
  transition: background 0.15s;
}
.app-user-card:hover { background: var(--hover); }

.app-user-avatar {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent), #6d28d9);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 700;
  font-size: 13px;
  flex-shrink: 0;
}

.app-user-info { flex: 1; min-width: 0; }
.app-user-name {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.app-user-meta {
  font-size: 10.5px;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- Topbar ---------- */
.app-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.app-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56px;
  padding: 0 20px;
  background: var(--panel);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 30;
  gap: 12px;
}

.app-topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }

.app-topbar-mode {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
}

.app-topbar-mode.demo {
  background: rgba(99, 102, 241, 0.15);
  color: var(--accent-hi);
}

.app-topbar-mode .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  animation: appBlink 2s infinite;
}

@keyframes appBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.app-topbar-actions { display: flex; align-items: center; gap: 4px; }

.app-icon-btn {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: transparent;
  border: 1px solid transparent;
  color: var(--meta);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.12s;
  position: relative;
  font-family: inherit;
}

.app-icon-btn:hover { background: var(--elevated); color: var(--text); border-color: var(--border); }

.app-icon-btn .badge {
  position: absolute;
  top: 4px;
  right: 4px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  background: var(--danger);
  color: #fff;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ---------- Content ---------- */
.app-content {
  padding: 24px;
  flex: 1;
  overflow-x: hidden;
  min-width: 0;
}

.app-tab { display: none; }
.app-tab.active { display: block; animation: appFadeIn 0.2s ease; }

@keyframes appFadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- Hero ---------- */
.app-hero { margin-bottom: 20px; }
.app-hero-title { font-size: 20px; font-weight: 700; letter-spacing: -0.3px; }
.app-hero-sub {
  font-size: 13px;
  color: var(--meta);
  margin-top: 4px;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* ---------- KPI cards ---------- */
.app-kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.app-kpi {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
}

.app-kpi-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 8px;
}

.app-kpi-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5px;
  line-height: 1.1;
}

.app-kpi-delta {
  font-size: 12px;
  margin-top: 6px;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 4px;
}

.app-kpi-delta.up { color: var(--success); }
.app-kpi-delta.down { color: var(--danger); }

/* ---------- Panel ---------- */
.app-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  margin-bottom: 16px;
}

.app-panel-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.app-panel-title-left { display: flex; align-items: center; gap: 8px; }
.app-panel-title i { color: var(--accent-hi); font-size: 13px; }

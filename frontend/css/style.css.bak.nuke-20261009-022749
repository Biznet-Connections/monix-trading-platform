  border: 2px solid transparent;
  border-radius: 12px;
  padding: 14px;
  cursor: pointer;
  transition: all 0.15s;
  text-align: center;
}

.strategy-card:hover { border-color: var(--border-hi); }

.strategy-card.active {
  border-color: var(--accent);
  background: rgba(99,102,241,0.1);
}

.strategy-card-title {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4px;
}

.strategy-card-desc {
  font-size: 11.5px;
  color: var(--muted);
  line-height: 1.4;
}

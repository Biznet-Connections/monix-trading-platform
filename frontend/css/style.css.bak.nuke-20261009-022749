  color: var(--border-hi);
}
.app-empty-title { color: var(--text); font-size: 14px; font-weight: 600; margin-bottom: 6px; }
.app-empty-desc { font-size: 12.5px; color: var(--muted); margin-bottom: 14px; }

/* ---------- Activity list ---------- */
.app-act-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}
.app-act-row:last-child { border-bottom: none; }

.app-act-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: var(--elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: var(--accent-hi);
  flex-shrink: 0;
}

.app-act-body { flex: 1; min-width: 0; }
.app-act-title { font-size: 13px; font-weight: 600; color: var(--text); }
.app-act-meta { font-size: 11px; color: var(--muted); margin-top: 2px; }
.app-act-amount { font-size: 13px; font-weight: 700; white-space: nowrap; }
.app-act-amount.up { color: var(--success); }
.app-act-amount.down { color: var(--danger); }

/* ---------- Bottom nav (mobile) ---------- */
.app-bottom-nav { display: none; }

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
    padding-bottom: 80px;
  }

  .app-sidebar { display: none; }

  .app-topbar { padding: 0 14px; height: 52px; }
  .app-content { padding: 16px; }

  .app-bottom-nav {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;

  font-size: 14px;
  flex-shrink: 0;
}

.app-suggestion-body { flex: 1; }
.app-suggestion-title { font-size: 13.5px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.app-suggestion-desc { font-size: 12.5px; color: var(--meta); line-height: 1.5; }
.app-suggestion-actions { display: flex; gap: 8px; margin-top: 12px; }

/* ---------- Buttons ---------- */
.app-btn {
  height: 36px;
  padding: 0 14px;

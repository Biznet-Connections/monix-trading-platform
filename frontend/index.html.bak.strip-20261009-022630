<script>
// Collapsible toggle function
function toggleCollapsible(contentId, iconId) {
    const content = document.getElementById(contentId);
    const icon = document.getElementById(iconId);
    if (!content || !icon) return;
    const isHidden = content.style.display === 'none' || !content.style.display;
    content.style.display = isHidden ? 'block' : 'none';
    icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
    localStorage.setItem(`collapsible_${contentId}`, isHidden ? 'open' : 'closed');
}

// Restore collapsible states on load
document.addEventListener('DOMContentLoaded', () => {
    ['recentTradesContent'].forEach(id => {
        const state = localStorage.getItem(`collapsible_${id}`);
        const content = document.getElementById(id);
        const icon = document.getElementById(id.replace('Content', 'Icon'));
        if (content && icon) {
            if (state === 'closed') {
                content.style.display = 'none';
                icon.style.transform = 'rotate(0deg)';
            } else {
                content.style.display = 'block';
                icon.style.transform = 'rotate(180deg)';
            }
        }
    });
});

// REAL token eye toggle
const toggleRealToken = document.getElementById('toggleRealToken');
const realTokenInput = document.getElementById('realToken');
if (toggleRealToken && realTokenInput) {
    toggleRealToken.addEventListener('click', function() {
        const type = realTokenInput.getAttribute('type') === 'password' ? 'text' : 'password';
        realTokenInput.setAttribute('type', type);
        this.querySelector('i').classList.toggle('fa-eye');
        this.querySelector('i').classList.toggle('fa-eye-slash');
    });
}

// Login password eye toggle
const toggleLoginPassword = document.getElementById('toggleLoginPassword');
const loginPasswordInput = document.getElementById('loginPassword');
if (toggleLoginPassword && loginPasswordInput) {
    toggleLoginPassword.addEventListener('click', function() {
        const type = loginPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        loginPasswordInput.setAttribute('type', type);
        this.querySelector('i').classList.toggle('fa-eye');
        this.querySelector('i').classList.toggle('fa-eye-slash');
    });
}

// Register password eye toggle
const toggleRegPassword = document.getElementById('toggleRegPassword');
const regPasswordInput = document.getElementById('regPassword');
if (toggleRegPassword && regPasswordInput) {
    toggleRegPassword.addEventListener('click', function() {
        const type = regPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        regPasswordInput.setAttribute('type', type);
        this.querySelector('i').classList.toggle('fa-eye');
        this.querySelector('i').classList.toggle('fa-eye-slash');
    });
}
</script>
